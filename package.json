{
  "name": "filo",
  "version": "1.0.0",
  "private": true,
  "description": "filo — plug-and-play permanent file archive for any file type — Cloudflare Worker + R2 + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "dev:vite": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:pages": "npm run build && cp wrangler.toml .wrangler.worker.toml && (cp wrangler.pages.toml wrangler.toml && wrangler pages deploy dist --project-name fileo --branch main; STATUS=$?; mv .wrangler.worker.toml wrangler.toml; exit $STATUS)",
    "db:migrate": "wrangler d1 migrations apply filo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply filo-db --remote",
    "db:export": "wrangler d1 export filo-db --remote --output ./backup-d1.sql",
    "backup": "bash scripts/backup.sh",
    "db:migrate:old": "wrangler d1 execute filo-db --file=./migrations/0001_docs.sql",
    "cron:local": "curl -s \"http://localhost:8787/__scheduled?cron=0+6+*+*+1\" | head -c 2000",
    "r2:create": "wrangler r2 bucket create filo-files",
    "secret:token": "wrangler secret put UPLOAD_TOKEN",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "lucide-svelte": "^1.0.1",
    "svelte": "^5.57.0"
  }
}
