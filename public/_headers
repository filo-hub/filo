# Static-asset headers (Pages applies these to dist/ files; /api/* and
# /p/* responses carry their own headers from the worker).
# style-src keeps 'unsafe-inline' for Svelte's inline style attributes
# (e.g. the storage-bar width) — no inline <script> is used anywhere.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; img-src 'self'; connect-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'
